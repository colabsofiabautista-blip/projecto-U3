        print(f"Preguntas totales: {len(PREGUNTAS_ANATOMIA)}\n")
    
    def hacer_pregunta(self, datos_pregunta, numero_pregunta):
        """
        Hace una pregunta individual y obtiene la respuesta del usuario
        
        Args:
            datos_pregunta: Diccionario con pregunta, opciones y respuesta correcta
            numero_pregunta: Número de la pregunta en el quiz
        
        Returns:
            True si es correcta, False si es incorrecta
        """
        print(f"\n--- Pregunta {numero_pregunta} de {len(PREGUNTAS_ANATOMIA)} ---")
        print(f"\n{datos_pregunta['pregunta']}\n")
        
        # Mostrar opciones
        for i, opcion in enumerate(datos_pregunta['opciones'], 1):
            print(f"  {i}. {opcion}")
        
        # Obtener respuesta del usuario
        while True:
            try:
                respuesta_usuario = int(input("\nTu respuesta (1-4): "))
                if 1 <= respuesta_usuario <= 4:
                    respuesta_usuario -= 1  # Convertir a índice basado en 0
                    break
                else:
                    print("¡Por favor ingresa un número entre 1 y 4!")
            except ValueError:
                print("¡Entrada inválida! Por favor ingresa un número.")
        
        # Verificar si la respuesta es correcta
        indice_correcta = datos_pregunta['correcta']
        es_correcta = respuesta_usuario == indice_correcta
        
        # Mostrar retroalimentación
        if es_correcta:
            print("\n✓ ¡CORRECTO! ¡Excelente trabajo!")
            self.respuestas_correctas += 1
            self.puntuacion += 10
        else:
            opcion_correcta = datos_pregunta['opciones'][indice_correcta]
            print(f"\n✗ ¡INCORRECTO! La respuesta correcta era: {opcion_correcta}")
            self.puntuacion += 0
        
        return es_correcta
    
