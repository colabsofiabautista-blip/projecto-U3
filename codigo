class JuegoAnatomia:
    def __init__(self):
        self.puntuacion = 0
        self.preguntas_totales = 0
        self.respuestas_correctas = 0
        
    def mostrar_bienvenida(self):
        """Muestra el mensaje de bienvenida"""
